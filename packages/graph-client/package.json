{
  "name": "@the-pit/graph-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Typed query layer over both subgraphs + the composed cross-subgraph query. Consumed by the board, the runner, and the agent.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
